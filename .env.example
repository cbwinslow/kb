# ==============================================================================
# Scientific Knowledge Base (kb) Configuration Template
# Copy this file to `.env` and adjust the variables for your environment.
# ==============================================================================

# Database Connection (PostgreSQL with pgvector, or local SQLite for portable dev)
# Homelab example:
KB_DATABASE_URL=postgresql+asyncpg://cbwinslow:123qweasd@cbwdellr720:5432/kb
# Standalone local portable example:
# KB_DATABASE_URL=sqlite+aiosqlite:///data/kb.db

# Storage Directories
KB_DATA_DIR=data
KB_FIXTURES_DIR=data/fixtures
KB_PDF_DOWNLOAD_DIR=data/arxiv_papers

# Resource & Hardware Safeguards
KB_DISK_MIN_FREE_GB=1.5
KB_GPU_VRAM_FRACTION=0.55

# Neural Embedder Settings
KB_EMBEDDING_MODEL=BAAI/bge-m3
KB_EMBEDDING_DEVICE=auto
KB_EMBEDDING_BATCH_SIZE=8

# Homelab Remote Archiving via SSH/SFTP (No Samba required)
KB_SSH_HOST=cbwdellr720
KB_SSH_PORT=22
KB_SSH_USER=cbwinslow
# KB_SSH_KEY_PATH=/path/to/id_ed25519
# KB_SSH_PASSWORD=your_password_here
KB_SSH_REMOTE_PDF_DIR=/data/kb/pdfs
KB_SSH_REMOTE_FIXTURES_DIR=/data/kb/fixtures

# Web Dashboard
KB_UI_HOST=127.0.0.1
KB_UI_PORT=8080
